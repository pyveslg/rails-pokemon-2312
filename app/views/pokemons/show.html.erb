<div class="row">
  <div class="col-12 col-md-6">
    <%= link_to "< Pokedex", root_path %>
    <p class="my-3">Tu entends un frémissement dans les herbes hautes. Un pokémon sauvage apparaît !</p>
    <div class="card-pokemon my-3">
      <%= cl_image_tag @pokemon.photo.key %>
      <p class="fs-4"><%= @pokemon.name %></p>
      <p><%= @pokemon.element_type %></p>
    </div>
  </div>
  <div class="col-12 col-md-6">
    <%= simple_form_for [@pokemon, @pokeball] do |f| %>
      <%= f.association :trainer %>
      <%= f.input :caught_on %>
      <%= f.input :location, collection: ["Vermilion City", "Cerulean City", "Pewter City", "Saffron City", "Celadon City", "Cinnabar Island", "Fuchsia City"] %>
      <%= f.submit "Attrape-le!", class: "btn btn-warning" %>
    <% end %>
    
  </div>
</div>
